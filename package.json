{
  "name": "starry-isle",
  "private": true,
  "version": "0.1.0",
  "description": "星屿 Starry Isle —— 公益开源的儿童情绪认知辅助训练应用（面向孤独症谱系儿童家庭，家长共玩）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:words": "node scripts/check-banned-words.mjs",
    "check:disclaimer": "node scripts/check-disclaimer.mjs",
    "check": "npm run check:words && npm run check:disclaimer && tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
